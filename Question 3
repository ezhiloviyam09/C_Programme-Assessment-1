#include <stdio.h>

int main()
{
    int coins, x, y;
    int ben, blackbeard, remaining, pirate;

    scanf("%d", &coins);
    scanf("%d", &x);
    scanf("%d", &y);

    ben = coins * x / 100;
    remaining = coins - ben;

    blackbeard = remaining * y / 100;
    remaining = remaining - blackbeard;

    pirate = remaining / 3;

    printf("%d\n", ben);
    printf("%d\n", blackbeard);
    printf("%d\n", pirate);

    return 0;
}

